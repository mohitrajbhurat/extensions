{
  "manifest_version": 3,
  "name": "Reading Studio",
  "short_name": "Reading Studio",
  "description": "Reader view, read aloud with sentence highlighting, dark mode for any site, and focus aids. Fully offline.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Reading Studio",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "activeTab", "scripting", "tts", "contextMenus"],
  "optional_host_permissions": ["*://*/*"],
  "commands": {
    "toggle-reader": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Open or close Reader view"
    },
    "read-aloud": {
      "description": "Read aloud: start, pause or resume"
    },
    "toggle-dark": {
      "description": "Toggle dark mode on the current site"
    },
    "toggle-ruler": {
      "description": "Toggle the reading ruler"
    }
  }
}
