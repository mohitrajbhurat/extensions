{
  "manifest_version": 3,
  "name": "Request Rewriter",
  "short_name": "Rewriter",
  "description": "Rewrite requests while you test: headers, redirects, host swaps, query params, blocks, mocks and user-agent overrides.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Request Rewriter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "editor/editor.html",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "toggle-pause": {
      "description": "Pause or resume all rules"
    },
    "open-editor": {
      "description": "Open the rule editor"
    }
  }
}
