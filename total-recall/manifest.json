{
  "manifest_version": 3,
  "name": "Total Recall",
  "short_name": "Total Recall",
  "description": "Full-text search over every page you've read. Private, local and offline: your browsing memory never leaves this device.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Total Recall",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "omnibox": { "keyword": "tr" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/extract.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "unlimitedStorage", "alarms", "scripting", "activeTab", "favicon"],
  "incognito": "not_allowed",
  "commands": {
    "open-search": {
      "description": "Open Total Recall search"
    }
  }
}
