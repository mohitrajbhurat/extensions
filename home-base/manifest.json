{
  "manifest_version": 3,
  "name": "Home Base",
  "short_name": "Home Base",
  "description": "A calm new tab dashboard with tasks: focus, clock, daily backgrounds, quotes, links, notes, calendar, habits and a pomodoro timer.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "action": {
    "default_title": "Home Base",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "search",
    "favicon"
  ],
  "commands": {
    "open-tasks": {
      "description": "Open the Home Base task manager"
    },
    "quick-add": {
      "description": "Add a task in Home Base"
    }
  }
}
