{
  "manifest_version": 3,
  "name": "Tab Workspaces",
  "short_name": "Workspaces",
  "description": "Workspaces, tab stash, session backups, memory saver, duplicate guard, auto-grouping and a searchable closed-tab archive.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Tab Workspaces",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_page": "dashboard/dashboard.html",
  "permissions": ["tabs", "tabGroups", "storage", "unlimitedStorage", "alarms", "contextMenus", "notifications", "favicon"],
  "optional_permissions": ["scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": { "description": "Open the Tab Workspaces popup" },
    "open-dashboard": { "description": "Open the dashboard" },
    "stash-all": { "description": "Stash all tabs in the current window" },
    "stash-others": { "description": "Stash all tabs except the current one" },
    "suspend-others": { "description": "Suspend other tabs in the current window" },
    "close-duplicates": { "description": "Close duplicate tabs" },
    "next-workspace": { "description": "Switch to the next workspace" },
    "previous-workspace": { "description": "Switch to the previous workspace" }
  }
}
