{
  "manifest_version": 3,
  "name": "Privacy Shield",
  "short_name": "Shield",
  "description": "Blocks cross-site trackers, strips tracking parameters, answers cookie banners for you and sends Global Privacy Control.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Privacy Shield",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "declarativeNetRequest",
    "webRequest",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "ws://*/*",
    "wss://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules/ads.json" },
      { "id": "analytics", "enabled": true, "path": "rules/analytics.json" },
      { "id": "social", "enabled": true, "path": "rules/social.json" },
      { "id": "fingerprinting", "enabled": true, "path": "rules/fingerprinting.json" },
      { "id": "session-replay", "enabled": true, "path": "rules/session-replay.json" },
      { "id": "params", "enabled": true, "path": "rules/params.json" },
      { "id": "gpc", "enabled": true, "path": "rules/gpc.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/consent-rules.js", "content/consent.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-site-protection": {
      "description": "Turn protection on or off for the current site"
    },
    "open-dashboard": {
      "description": "Open the Privacy Shield dashboard"
    }
  }
}
