{
  "manifest_version": 3,
  "name": "Point-and-Click Scraper",
  "short_name": "Page Scraper",
  "description": "Turn tables and product lists on any page into spreadsheet-ready data. Auto-detect, point and click, paginate, export.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Point-and-Click Scraper",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "manager/manager.html",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "open-scraper": {
      "description": "Open the scraper panel and auto-detect data on the current page"
    },
    "pick-manually": {
      "description": "Open the scraper panel in point-and-click mode"
    }
  }
}
