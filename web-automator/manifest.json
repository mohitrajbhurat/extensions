{
  "manifest_version": 3,
  "name": "Web Automator",
  "short_name": "Automator",
  "description": "Record, edit and replay browser workflows: clicks, form filling, data extraction, CSV-driven runs and schedules.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Web Automator",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab", "alarms", "notifications", "webNavigation"],
  "optional_host_permissions": ["<all_urls>"],
  "options_page": "editor/editor.html",
  "commands": {
    "toggle-recording": { "description": "Start or stop recording in the current tab" },
    "open-editor": { "description": "Open the macro editor" }
  }
}
