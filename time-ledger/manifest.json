{
  "manifest_version": 3,
  "name": "Time Ledger",
  "short_name": "Time Ledger",
  "description": "Automatic time tracking, timer, screen-time goals and billable timesheets. Private and offline.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Time Ledger",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "app/app.html",
  "permissions": ["storage", "unlimitedStorage", "tabs", "idle", "alarms", "notifications"],
  "commands": {
    "_execute_action": {
      "description": "Open the Time Ledger popup"
    },
    "toggle-timer": {
      "description": "Start or stop the timer (continues your last entry)"
    },
    "toggle-tracking": {
      "description": "Pause or resume automatic tracking"
    }
  }
}
